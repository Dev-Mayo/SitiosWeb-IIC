@page
@model AdminPersonalWebCore.Pages.GEN.AdminInsEducativasModel
@{
    ViewData["Title"] = "Instituciones Educativas";
}

@section Styles {
    <style>
        .card-custom {
            border-radius: 14px;
            box-shadow: 0 6px 28px rgba(0,0,0,.15);
            overflow: hidden;
        }

        .card-header-custom {
            background: #1aad94;
            padding: 20px;
            text-align: center;
            color: white;
        }
    </style>
}

<div class="card-custom bg-white">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0">Administración de Instituciones Educativas</h5>
    </div>

    <div class="p-4">

        @* ── MODAL MENSAJE ── *@
        <div id="modalMensaje" class="modal fade" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-warning text-dark">
                        <h5 class="modal-title">Mensaje del sistema</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <span id="txtMensajeSistema">@Model.MensajeSistema</span>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>

        <button type="button" class="btn btn-primary mb-3 fw-semibold"
                data-bs-toggle="modal" data-bs-target="#modalForm"
                onclick="limpiarModal()">
            Nuevo
        </button>

      
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inst in Model.Instituciones)
                    {
                        <tr>
                            <td>@inst.codigo_institucion</td>
                            <td>@inst.nombre</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-warning me-1"
                                        onclick="abrirEditar('@inst.codigo_institucion',
                                                '@inst.nombre')">
                                    Editar
                                </button>
                                <button type="button" class="btn btn-sm btn-danger"
                                        onclick="confirmarEliminar('@inst.codigo_institucion')">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Instituciones.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">
                                No hay instituciones registradas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

       
        @if (Model.TotalPaginas > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                            <a class="page-link"
                               href="/GEN/AdminInsEducativas?u=@Model.UsuarioActual&page=@i">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }

    </div>
</div>


<div class="modal fade" id="modalForm" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:#1aad94; color:white;">
                <h5 class="modal-title" id="modalFormTitulo">Institución Educativa</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Guardar"
                  asp-route-u="@Model.UsuarioActual">
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    @if (!string.IsNullOrEmpty(Model.ErrorForm))
                    {
                        <div class="alert alert-danger">@Model.ErrorForm</div>
                    }

                    <input type="hidden" id="formAccion" name="accion" value="crear" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Código</label>
                        <input type="text" id="formCodigo" name="codigo"
                               class="form-control" maxlength="50" required
                               value="@Model.FormCodigo" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre</label>
                        <input type="text" id="formNombre" name="nombre"
                               class="form-control" maxlength="150" required
                               value="@Model.FormNombre" />
                        <small class="text-muted">
                            Máximo 150 caracteres, solo letras.
                        </small>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cerrar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Realmente desea eliminar el elemento seleccionado?</p>
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Eliminar"
                      asp-route-u="@Model.UsuarioActual">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="eliminarCodigo" name="codigo" />
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function limpiarModal() {
            document.getElementById('formAccion').value  = 'crear';
            document.getElementById('formCodigo').value  = '';
            document.getElementById('formNombre').value  = '';
            document.getElementById('formCodigo').readOnly = false;
            document.getElementById('modalFormTitulo').innerText = 'Nueva Institución';
        }

        function abrirEditar(codigo, nombre) {
            document.getElementById('formAccion').value  = 'editar';
            document.getElementById('formCodigo').value  = codigo;
            document.getElementById('formNombre').value  = nombre;
            document.getElementById('formCodigo').readOnly = true; // PK can't change
            document.getElementById('modalFormTitulo').innerText = 'Editar Institución';
            new bootstrap.Modal(document.getElementById('modalForm')).show();
        }

        function confirmarEliminar(codigo) {
            document.getElementById('eliminarCodigo').value = codigo;
            new bootstrap.Modal(document.getElementById('modalEliminar')).show();
        }

        
        @if (!string.IsNullOrEmpty(Model.ErrorForm))
        {
                <text>
                document.addEventListener('DOMContentLoaded', function () {
                    var modal = new bootstrap.Modal(document.getElementById('modalForm'));
                    modal.show();
                    
                    @if (Model.FormAccion == "editar")
                    {
                            <text>
                            document.getElementById('formCodigo').readOnly = true;
                            document.getElementById('formAccion').value = 'editar';
                            document.getElementById('modalFormTitulo').innerText = 'Editar Institución';
                            </text>
                    }
                });
                </text>
        }
        @if (!string.IsNullOrEmpty(Model.MensajeSistema))
        {
                <text>
                document.addEventListener('DOMContentLoaded', function () {
                    new bootstrap.Modal(document.getElementById('modalMensaje')).show();
                });
                </text>
        }
    </script>
}