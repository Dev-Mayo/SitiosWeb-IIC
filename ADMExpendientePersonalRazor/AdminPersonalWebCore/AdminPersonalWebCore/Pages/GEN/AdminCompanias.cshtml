@page
@model AdminPersonalWebCore.Pages.GEN.AdminCompaniasModel

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header text-white" style="background:#1aad94;">
            <h4 class="mb-0">Administración de Compañías</h4>
        </div>

        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.Mensaje))
            {
                <div class="alert alert-info">@Model.Mensaje</div>
            }

            <button type="button" class="btn btn-primary mb-3"
                    data-bs-toggle="modal"
                    data-bs-target="#modalCompania"
                    onclick="nuevoCompania()">
                Nuevo
            </button>

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th style="width:220px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Companias)
                    {
                        <tr>
                            <td>@item.CodigoCompania</td>
                            <td>@item.Nombre</td>
                            <td>
                                <button type="button"
                                        class="btn btn-warning btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalCompania"
                                        onclick="editarCompania('@item.CodigoCompania', '@item.Nombre')">
                                    Editar
                                </button>

                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEliminar"
                                        onclick="prepararEliminar('@item.CodigoCompania', '@item.Nombre')">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Crear / Editar -->
<div class="modal fade" id="modalCompania" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Guardar">
                <div class="modal-header text-white" style="background:#1aad94;">
                    <h5 class="modal-title" id="tituloModalCompania">Formulario Compañía</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="EsEdicion" name="EsEdicion" value="false" />

                    <div class="mb-3">
                        <label class="form-label">Código de compañía</label>
                        <input type="text"
                               id="CodigoCompania"
                               name="Compania.CodigoCompania"
                               class="form-control"
                               maxlength="50" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text"
                               id="Nombre"
                               name="Compania.Nombre"
                               class="form-control"
                               maxlength="150" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Guardar</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Eliminar">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="CodigoEliminar" name="codigo" />
                    <p>¿Realmente desea eliminar el elemento seleccionado?</p>
                    <strong id="NombreEliminar"></strong>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function nuevoCompania() {
            document.getElementById("tituloModalCompania").innerText = "Nueva Compañía";
            document.getElementById("EsEdicion").value = "false";
            document.getElementById("CodigoCompania").value = "";
            document.getElementById("Nombre").value = "";
            document.getElementById("CodigoCompania").readOnly = false;
        }

        function editarCompania(codigo, nombre) {
            document.getElementById("tituloModalCompania").innerText = "Editar Compañía";
            document.getElementById("EsEdicion").value = "true";
            document.getElementById("CodigoCompania").value = codigo;
            document.getElementById("Nombre").value = nombre;
            document.getElementById("CodigoCompania").readOnly = true;
        }

        function prepararEliminar(codigo, nombre) {
            document.getElementById("CodigoEliminar").value = codigo;
            document.getElementById("NombreEliminar").innerText = codigo + " - " + nombre;
        }
    </script>
}