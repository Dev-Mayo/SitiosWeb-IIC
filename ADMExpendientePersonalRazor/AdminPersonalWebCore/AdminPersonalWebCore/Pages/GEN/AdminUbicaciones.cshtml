@page
@model AdminPersonalWebCore.Pages.GEN.AdminUbicacionesModel

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header text-white" style="background:#1aad94;">
            <h4 class="mb-0">Carga de datos de ubicación</h4>
        </div>

        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.Mensaje))
            {
                <div class="alert alert-info">@Model.Mensaje</div>
            }

            <p>
                Seleccione un archivo CSV con el siguiente formato:
            </p>

            <pre>CodigoProvincia,Provincia,CodigoCanton,Canton,CodigoDistrito,Distrito</pre>

            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">Archivo CSV</label>
                    <input type="file"
                           name="Archivo"
                           class="form-control"
                           accept=".csv,.txt" />
                </div>

                <button type="submit" class="btn btn-success">
                    Cargar archivo
                </button>
            </form>
            <hr />

            <ul class="nav nav-tabs" id="ubicacionesTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#provincias" type="button">
                        Provincias
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#cantones" type="button">
                        Cantones
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#distritos" type="button">
                        Distritos
                    </button>
                </li>
            </ul>

            <div class="tab-content mt-3">
                <div class="tab-pane fade show active" id="provincias">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Provincia</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Provincias)
                            {
                                <tr>
                                    <td>@item.CodigoProvincia</td>
                                    <td>@item.Nombre</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="tab-pane fade" id="cantones">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Provincia</th>
                                <th>Código</th>
                                <th>Cantón</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Cantones)
                            {
                                <tr>
                                    <td>@item.Provincia</td>
                                    <td>@item.CodigoCanton</td>
                                    <td>@item.Nombre</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="tab-pane fade" id="distritos">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Cantón</th>
                                <th>Código</th>
                                <th>Distrito</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Distritos)
                            {
                                <tr>
                                    <td>@item.Canton</td>
                                    <td>@item.CodigoDistrito</td>
                                    <td>@item.Nombre</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>