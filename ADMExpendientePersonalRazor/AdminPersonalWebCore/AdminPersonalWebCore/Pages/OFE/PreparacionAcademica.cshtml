@page
@model AdminPersonalWebCore.Pages.OFE.PreparacionAcademicaModel
@{
    ViewData["Title"] = "Preparación Académica";
}

<div class="card-custom bg-white">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0">Administración de preparación académica</h5>
    </div>

    <div class="p-4">
        <a asp-page="FormularioOferente/PreparacionAcademicaForm"
           asp-route-oferenteId="@Request.Query["id"]"
           asp-route-u="@Request.Query["u"]"
           class="btn btn-primary mb-3 fw-semibold">
            Nueva Preparación Académica
        </a>
        <a asp-page="MainOferentes"
           asp-route-u="@Request.Query["u"]"
           class="btn btn-secondary mb-3 fw-semibold">Volver</a>

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Preparación Académica</th>
                    <th>Institución</th>
                    <th>Oferente</th>
                    <th>Título</th>
                    <th>Fecha inicio</th>
                    <th>Fecha fin</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Preparaciones)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Institucion</td>
                        <td>@item.OferenteId</td>
                        <td>@item.Titulo</td>
                        <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-page="FormularioOferente/PreparacionAcademicaForm"
                               asp-route-id="@item.Id"
                               asp-route-oferenteId="@Request.Query["id"]"
                               asp-route-u="@Request.Query["u"]"
                               class="btn btn-sm btn-warning me-2">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <button type="button" class="btn btn-sm btn-danger"
                                    data-id="@item.Id"
                                    onclick="confirmarEliminar(@item.Id)">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @* Paginación simple *@
        @if (Model.TotalPaginas > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                            <a class="page-link"
                               asp-page="PreparacionAcademica"
                               asp-route-id="@Request.Query["id"]"
                               asp-route-u="@Request.Query["u"]"
                               asp-route-pagina="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

<!-- Modal Confirmar Eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Está seguro que desea eliminar la preparación académica?</p>
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Eliminar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="hfEliminarId" name="preparacionAcadId" />
                    <input type="hidden" name="u" value="@Request.Query["u"]" />
                    <input type="hidden" name="oferenteId" value="@Request.Query["id"]" />
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Mensaje del sistema -->
<div class="modal fade" id="modalMensaje" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Mensaje del sistema</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="mensajeTexto">@Model.Mensaje</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmarEliminar(id) {
            document.getElementById('hfEliminarId').value = id;
            var modal = new bootstrap.Modal(document.getElementById('modalEliminar'));
            modal.show();
        }

        @if (!string.IsNullOrEmpty(Model.Mensaje))
        {
            <text>
            window.addEventListener('DOMContentLoaded', function () {
                var modal = new bootstrap.Modal(document.getElementById('modalMensaje'));
                modal.show();
            });
            </text>
        }
    </script>
}

<style>
    .card-custom {
        width: calc(100% - 80px);
        max-width: none;
        margin: 40px;
        border-radius: 14px;
        box-shadow: 0 6px 28px rgba(0,0,0,.15);
    }
    .card-header-custom {
        background: #1aad94;
        padding: 20px;
        text-align: center;
        color: white;
        border-radius: 14px 14px 0 0;
    }
</style>
