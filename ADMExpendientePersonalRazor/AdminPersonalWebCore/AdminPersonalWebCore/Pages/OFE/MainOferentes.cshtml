@page
@model AdminPersonalWebCore.Pages.OFE.MainOferentes
@{
    ViewData["Title"] = "Administración de Oferentes";
}

<div class="card-custom bg-white">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0">Administración de Oferentes</h5>
    </div>

    <div class="p-4">
        <form method="post">
            <button asp-page-handler="Nuevo" class="btn btn-primary mb-3 fw-semibold">Nuevo</button>

            <input type="hidden" asp-for="IdOferente" />

            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Identificación</th>
                        <th>Nombre Completo</th>
                        <th>Email</th>
                        <th>Teléfono</th>
                        <th>Concurso</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var oferente in Model.Oferentes)
                    {
                        <tr>
                            <td>@oferente.Identificacion</td>
                            <td>@oferente.NombreCompleto</td>
                            <td>@oferente.EmailDisplay</td>
                            <td>@oferente.TelefonoDisplay</td>
                            <td>@oferente.ConcursoDisplay</td>
                            <td>
                                <div class="d-flex flex-column">
                                    <div class="mb-2">
                                        <button asp-page-handler="Editar" asp-route-id="@oferente.Identificacion"
                                                class="btn btn-sm btn-warning me-2">
                                            <i class="bi bi-pencil"></i> Editar
                                        </button>
                                        <button asp-page-handler="Eliminar" asp-route-id="@oferente.Identificacion"
                                                class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>
                                    </div>
                                    <div>
                                        <button asp-page-handler="PrepAcademica" asp-route-id="@oferente.Identificacion"
                                                class="btn btn-sm btn-primary me-2">
                                            <i class="bi bi-book"></i> Preparación Académica
                                        </button>
                                        <button asp-page-handler="ExpLaboral" asp-route-id="@oferente.Identificacion"
                                                class="btn btn-sm btn-primary">
                                            <i class="bi bi-briefcase"></i> Experiencia Laboral
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="/OFE/MainOferentes?u=@Model.FormUsuario&page=@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </form>
    </div>
</div>

<!-- Modal para Agregar / Editar Oferente -->
<div class="modal fade" id="modalOferente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header card-header-custom text-white">
                <h5 class="modal-title" id="modalTitle">Formulario Oferente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form method="post">
                <div class="modal-body">
                    <input type="hidden" asp-for="Accion" />

                    <!-- Tipo de identificación -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipo de identificación</label>
                        <select asp-for="Oferente.TipoIdentificacion" class="form-select"
                                asp-items="Model.TiposIdentificacion">
                        </select>
                    </div>

                    <!-- Identificación -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Identificación</label>
                        <input asp-for="Oferente.Identificacion" class="form-control" />
                        <span asp-validation-for="Oferente.Identificacion" class="text-danger"></span>
                    </div>

                    <!-- Nombre completo -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre completo</label>
                        <input asp-for="Oferente.NombreCompleto" class="form-control" />
                    </div>

                    <!-- Fecha de nacimiento -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Fecha de nacimiento</label>
                        <input asp-for="Oferente.FechaNacimiento" type="date" class="form-control" />
                    </div>

                    <!-- Correos electrónicos -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Correos electrónicos</label>
                        @for (int i = 0; i < Model.Oferente.Email.Count; i++)
                        {
                            <div class="input-group mb-2">
                                <input asp-for="Oferente.Email[i]" class="form-control" />
                                <button type="submit" asp-page-handler="EliminarCorreo" asp-route-index="@i"
                                        class="btn btn-danger">
                                    X
                                </button>
                            </div>
                        }
                        <button type="submit" asp-page-handler="AgregarCorreo" class="btn btn-sm btn-success">Agregar correo</button>
                    </div>

                    <!-- Teléfonos -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Teléfonos de contacto</label>
                        @for (int i = 0; i < Model.Oferente.Telefono.Count; i++)
                        {
                            <div class="input-group mb-2">
                                <input asp-for="Oferente.Telefono[i]" class="form-control" />
                                <button type="submit" asp-page-handler="EliminarTelefono" asp-route-index="@i"
                                        class="btn btn-danger">
                                    X
                                </button>
                            </div>
                        }
                        <button type="submit" asp-page-handler="AgregarTelefono" class="btn btn-sm btn-success">Agregar teléfono</button>
                    </div>

                    <!-- Concursos -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Concursos</label>
                        @foreach (var concurso in Model.Oferente.CodigoConcurso)
                        {
                            <div class="form-check">
                                <input type="checkbox" name="ConcursosSeleccionados" value="@concurso"
                                       class="form-check-input" />
                                <label class="form-check-label">@concurso</label>
                            </div>
                        }
                    </div>

                    <span class="form-label fw-semibold text-danger">@Model.MensajeError</span>
                </div>

                <div class="modal-footer">
                    <button type="submit" asp-page-handler="GuardarOferente" class="btn btn-primary">Guardar</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- Modal Confirmación Eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Está seguro que desea eliminar este oferente?</p>
            </div>
            <div class="modal-footer">
                <form method="post">
                    <button asp-page-handler="ConfirmarEliminar" class="btn btn-danger">Eliminar</button>
                </form>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Mensaje -->
<div class="modal fade" id="modalMensaje" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Mensaje del sistema</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @Model.MensajeModal
            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var mostrar = '@Model.MostrarModal';
            if (mostrar === 'True') {
                var modalEl = document.getElementById('modalOferente');
                var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        });
    </script>
}
