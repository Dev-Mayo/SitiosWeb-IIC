@page
@model AdminPersonalWebCore.Pages.OFE.MainOferentesModel
@{
    ViewData["Title"] = "Administración de Oferentes";
}

<style>
    .card-custom {
        width: calc(100% - 80px);
        margin: 40px;
        border-radius: 14px;
        box-shadow: 0 6px 28px rgba(0,0,0,.15);
    }
    .card-header-custom {
        background: #1aad94;
        padding: 20px;
        text-align: center;
        color: white;
        border-radius: 14px 14px 0 0;
    }
    .grid-pager { text-align: center; padding: 10px 0; }
</style>

<div class="card-custom bg-white">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0">Administración de Oferentes</h5>
    </div>
    <div class="p-4">

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @TempData["Mensaje"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @* Botón Nuevo → navega a la página de formulario *@
        <a href="/OFE/FormularioOferente/OferenteForm?u=@Request.Query["u"]&accion=nuevo"
           class="btn btn-primary mb-3 fw-semibold">
            Nuevo
        </a>

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Identificación</th>
                    <th>Nombre Completo</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Concurso</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.OferentesPaginados)
                {
                    <tr>
                        <td>@o.Identificacion</td>
                        <td>@o.NombreCompleto</td>
                        <td>@string.Join(", ", o.Email)</td>
                        <td>@string.Join(", ", o.Telefono)</td>
                        <td>@string.Join(", ", o.CodigoConcurso)</td>
                        <td>
                            <div class="d-flex flex-column gap-2">
                                <div>
                                    @* Editar → navega a formulario con id *@
                                    <a href="/OFE/FormularioOferente/OferenteForm?u=@Request.Query["u"]&accion=editar&id=@o.Identificacion"
                                       class="btn btn-sm btn-warning me-2">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    @* Eliminar *@
                                    <button type="button" class="btn btn-sm btn-danger"
                                            onclick="confirmarEliminar('@o.Identificacion')">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </div>
                                <div>
                                    <a href="/OFE/PreparacionAcademica?u=@Request.Query["u"]&id=@o.Identificacion"
                                       class="btn btn-sm btn-primary me-2">
                                        <i class="bi bi-book"></i> Preparación académica
                                    </a>
                                    <a href="/OFE/ExperienciaLaboral?u=@Request.Query["u"]&id=@o.Identificacion"
                                       class="btn btn-sm btn-primary">
                                        <i class="bi bi-briefcase"></i> Experiencia Laboral
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPaginas > 1)
        {
            <div class="grid-pager">
                <nav>
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Model.TotalPaginas; i++)
                        {
                            <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                                <a class="page-link" href="?u=@Request.Query["u"]&pagina=@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }

    </div>
    <!-- Modal Confirmar Eliminar -->
<div id="modalEliminar" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white" 
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Está seguro que desea eliminar este oferente?</p>
            </div>
            <div class="modal-footer">
                <form id="formEliminar" method="post" asp-page-handler="Eliminar">
                    <input type="hidden" id="hfEliminarId" name="identificacion" />
                    <input type="hidden" name="u" value="@Request.Query["u"]" />
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-secondary" 
                            data-bs-dismiss="modal">Cancelar</button>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script>
    function confirmarEliminar(identificacion) {
        document.getElementById('hfEliminarId').value = identificacion;
        new bootstrap.Modal(document.getElementById('modalEliminar')).show();
    }
</script>
}
