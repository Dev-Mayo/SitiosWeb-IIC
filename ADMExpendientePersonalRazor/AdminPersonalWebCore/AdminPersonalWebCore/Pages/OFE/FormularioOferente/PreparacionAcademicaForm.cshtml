@page
@model AdminPersonalWebCore.Pages.OFE.FormularioOferente.PreparacionAcademicaFormModel
@{
    ViewData["Title"] = Model.EsNuevo ? "Nueva Preparación Académica" : "Editar Preparación Académica";
    string titulo = Model.EsNuevo ? "Nueva Preparación Académica" : "Editar Preparación Académica";
}

<div class="card-custom bg-white">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0">@titulo</h5>
    </div>

    <div class="p-4">
        <form method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Input.Id" />
            <input type="hidden" asp-for="Input.OferenteId" />
            <input type="hidden" name="u" value="@Request.Query["u"]" />

            <div class="mb-3">
                <label class="form-label fw-semibold">Preparación Académica (ID)</label>
                <input class="form-control" value="@(Model.EsNuevo ? "0 (nuevo)" : Model.Input.Id.ToString())" disabled />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Institución</label>
                <select asp-for="Input.CodigoInstitucion"
                        asp-items="Model.Instituciones"
                        class="form-select">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="Input.CodigoInstitucion" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Oferente</label>
                <input class="form-control" value="@Model.Input.OferenteId" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="Input.Titulo" class="form-label fw-semibold">Título</label>
                <input asp-for="Input.Titulo" class="form-control" />
                <span asp-validation-for="Input.Titulo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.FechaInicio" class="form-label fw-semibold">Fecha inicio</label>
                <input asp-for="Input.FechaInicio" type="date" class="form-control" />
                <span asp-validation-for="Input.FechaInicio" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.FechaFin" class="form-label fw-semibold">Fecha fin</label>
                <input asp-for="Input.FechaFin" type="date" class="form-control" />
                <span asp-validation-for="Input.FechaFin" class="text-danger small"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary fw-semibold">Guardar</button>
                <a asp-page="/OFE/PreparacionAcademica"
                   asp-route-id="@Model.Input.OferenteId"
                   asp-route-u="@Request.Query["u"]"
                   class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>



<style>
    .card-custom {
        width: calc(100% - 80px);
        max-width: none;
        margin: 40px;
        border-radius: 14px;
        box-shadow: 0 6px 28px rgba(0,0,0,.15);
    }
    .card-header-custom {
        background: #1aad94;
        padding: 20px;
        text-align: center;
        color: white;
        border-radius: 14px 14px 0 0;
    }
</style>
