@page
@model AdminPersonalWebCore.Pages.OFE.MainOferentesModel
@{
    ViewData["Title"] = "Administración de Oferentes";
}

<div class="card-custom bg-white">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0">Administración de Oferentes</h5>
    </div>

    <div class="p-4">
        <a asp-page="CrearOferente" class="btn btn-primary mb-3 fw-semibold">Nuevo</a>

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Identificación</th>
                    <th>Nombre Completo</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Concurso</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var oferente in Model.Oferentes)
                {
                    <tr>
                        <td>@oferente.Identificacion</td>
                        <td>@oferente.NombreCompleto</td>
                        <td>@oferente.EmailDisplay</td>
                        <td>@oferente.TelefonoDisplay</td>
                        <td>@oferente.ConcursoDisplay</td>
                        <td>
                            <a asp-page="EditarOferente" asp-route-id="@oferente.Identificacion"
                               class="btn btn-sm btn-warning me-2">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <a asp-page="EliminarOferente" asp-route-id="@oferente.Identificacion"
                               class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
