@page
@model AdminPersonalWebCore.Pages.OFE.ExpLaboralModel
@{
    ViewData["Title"] = "Experiencia Laboral";
}

<style>
    .card-custom {
        width: calc(100% - 80px);
        max-width: none;
        margin: 40px;
        border-radius: 14px;
        box-shadow: 0 6px 28px rgba(0,0,0,.15);
    }
    .card-header-custom {
        background: #1aad94;
        padding: 20px;
        text-align: center;
        color: white;
        border-radius: 14px 14px 0 0;
    }
    .table { width: 100%; }
    .grid-pager { text-align: center; padding-top: 10px; padding-bottom: 10px; }
</style>

<div class="card-custom bg-white">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0">Experiencia Laboral</h5>
    </div>

    <div class="p-4">

        <button type="button" class="btn btn-primary mb-3 fw-semibold" onclick="abrirModalNuevo()">
            <i class="bi bi-plus-lg"></i> Nueva Experiencia
        </button>
        <a href="/OFE/MainOferentes?u=@Request.Query["u"]" class="btn btn-secondary mb-3 fw-semibold"> Volver</a>

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Empresa</th>
                    <th>Puesto</th>
                    <th>Fecha Inicio</th>
                    <th>Fecha Fin</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ExpLaboralesPaginadas)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Empresa</td>
                        <td>@item.Puesto</td>
                        <td>@item.FechaInicio.ToString("yyyy-MM-dd")</td>
                        <td>@item.FechaFin.ToString("yyyy-MM-dd")</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-warning me-1"
                                onclick="abrirModalEditar(@item.Id)">
                                <i class="bi bi-pencil"></i> Editar
                            </button>
                            <button type="button" class="btn btn-sm btn-danger"
                                onclick="abrirModalEliminar(@item.Id)">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </td>
                    </tr>
                }
                @if (!Model.ExpLaboralesPaginadas.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted fst-italic py-3">
                            No hay experiencias laborales registradas.
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPaginas > 1)
        {
            <div class="grid-pager">
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <a href="?pagina=@i&u=@Request.Query["u"]"
                       class="btn btn-sm @(i == Model.PaginaActual ? "btn-primary" : "btn-outline-secondary") me-1">
                        @i
                    </a>
                }
            </div>
        }

    </div>
</div>

<!-- ===== Modal Agregar / Editar ===== -->
<div id="modalExpLaboral" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header card-header-custom text-white">
                <h5 class="modal-title" id="modalExpLaboralTitle">Formulario Experiencia Laboral</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" id="formExpLaboral">
                <div class="modal-body">
                    <input type="hidden" id="hfAccion"   name="Accion" value="0" />
                    <input type="hidden" id="hfId"        name="Id"     value="0" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">ID</label>
                        <input type="text" id="txtId" class="form-control" disabled />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Empresa</label>
                        <input type="text" id="txtEmpresa" name="Empresa" class="form-control"
                               maxlength="200" placeholder="Escriba o seleccione una empresa"
                               list="listaEmpresas" autocomplete="off" />
                        <datalist id="listaEmpresas">
                            @foreach (var c in Model.Companias)
                            {
                                <option value="@c.Nombre" data-codigo="@c.CodigoCompania"></option>
                            }
                        </datalist>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Puesto</label>
                        <input type="text" id="txtPuesto" name="Puesto" class="form-control"
                               maxlength="200" placeholder="Puesto desempeñado" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Fecha de Inicio</label>
                            <input type="date" id="txtFechaInicio" name="FechaInicio" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Fecha de Fin</label>
                            <input type="date" id="txtFechaFin" name="FechaFin" class="form-control" />
                        </div>
                    </div>

                    <span id="lblMensajeError" class="form-label fw-semibold text-danger"></span>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-floppy"></i> Guardar
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== Modal Confirmar Eliminar ===== -->
<div id="modalEliminar" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Está seguro que desea eliminar esta experiencia laboral?</p>
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Eliminar" asp-route-u="@Request.Query["u"]">
                    <input type="hidden" id="hfEliminarId" name="id" value="" />
                    <button type="submit" class="btn btn-danger"> <i class="bi bi-trash"></i> Eliminar </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ===== Modal Mensaje Sistema ===== -->
<div id="modalMensaje" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Mensaje del sistema</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <span id="txtMensajeSistema">@Model.MensajeSistema</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const expData = @Html.Raw(Model.ExpLaboralesJson);

    function limpiarModal() {
        document.getElementById('hfId').value              = '0';
        document.getElementById('txtId').value             = '';
        document.getElementById('txtEmpresa').value        = '';
        document.getElementById('txtPuesto').value         = '';
        document.getElementById('txtFechaInicio').value    = '';
        document.getElementById('txtFechaFin').value       = '';
        document.getElementById('lblMensajeError').textContent = '';
    }

    function abrirModalNuevo() {
        limpiarModal();
        document.getElementById('modalExpLaboralTitle').textContent = 'Nueva Experiencia Laboral';
        document.getElementById('hfAccion').value = '0';
        document.getElementById('formExpLaboral').action = '?handler=Guardar&u=@Request.Query["u"]';
        new bootstrap.Modal(document.getElementById('modalExpLaboral')).show();
    }

    function abrirModalEditar(id) {
        const e = expData.find(x => x.id === id);
        if (!e) return;

        document.getElementById('modalExpLaboralTitle').textContent = 'Editar Experiencia Laboral';
        document.getElementById('hfAccion').value          = '1';
        document.getElementById('hfId').value              = e.id;
        document.getElementById('txtId').value             = e.id;
        document.getElementById('txtEmpresa').value        = e.empresa;
        document.getElementById('txtPuesto').value         = e.puesto;
        document.getElementById('txtFechaInicio').value    = e.fechaInicio;
        document.getElementById('txtFechaFin').value       = e.fechaFin;
        document.getElementById('lblMensajeError').textContent = '';
        document.getElementById('formExpLaboral').action   = '?handler=Guardar&u=@Request.Query["u"]';
        new bootstrap.Modal(document.getElementById('modalExpLaboral')).show();
    }

    function abrirModalEliminar(id) {
        document.getElementById('hfEliminarId').value = id;
        new bootstrap.Modal(document.getElementById('modalEliminar')).show();
    }

    window.addEventListener('DOMContentLoaded', function () {
        // Modal de mensaje del sistema
        const msg = document.getElementById('txtMensajeSistema').textContent.trim();
        if (msg) {
            new bootstrap.Modal(document.getElementById('modalMensaje')).show();
        }

        // Re-abrir modal si hubo error de validación en el POST
        const mostrar = '@Model.MostrarModalExpLaboral';
        if (mostrar !== 'True') return;

        const esEditar = '@Model.AccionActual' === '1';
        document.getElementById('modalExpLaboralTitle').textContent = esEditar
            ? 'Editar Experiencia Laboral'
            : 'Nueva Experiencia Laboral';
        document.getElementById('hfAccion').value          = '@Model.AccionActual';
        document.getElementById('hfId').value              = '@Model.IdActual';
        document.getElementById('txtId').value             = '@Model.IdActual';
        document.getElementById('txtEmpresa').value        = '@Model.EmpresaActual';
        document.getElementById('txtPuesto').value         = '@Model.PuestoActual';
        document.getElementById('txtFechaInicio').value    = '@Model.FechaInicioActual';
        document.getElementById('txtFechaFin').value       = '@Model.FechaFinActual';
        document.getElementById('lblMensajeError').textContent = '@Model.MensajeError';
        document.getElementById('formExpLaboral').action   = '?handler=Guardar&u=@Request.Query["u"]';
        new bootstrap.Modal(document.getElementById('modalExpLaboral')).show();
    });
</script>
}
