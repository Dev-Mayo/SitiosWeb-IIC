@page
@model AdminPersonalWebCore.Pages.OFE.AgendarEntrevistaModel
@{
    ViewData["Title"] = "Administración de Entrevistas";
}

<style>
    .card-custom {
        width: calc(100% - 80px);
        max-width: none;
        margin: 40px;
        border-radius: 14px;
        box-shadow: 0 6px 28px rgba(0,0,0,.15);
    }
    .card-header-custom {
        background: #1aad94;
        padding: 20px;
        text-align: center;
        color: white;
        border-radius: 14px 14px 0 0;
    }
    .table { width: 100%; }
    .grid-pager { text-align: center; padding-top: 10px; padding-bottom: 10px; }
</style>

<div class="card-custom bg-white">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0">Administración de entrevistas</h5>
    </div>

    <div class="p-4">

        @if (!string.IsNullOrEmpty(Model.MensajeSistema))
        {
            <!-- Se muestra via modal, no inline -->
        }

        <button type="button" class="btn btn-primary mb-3 fw-semibold" onclick="abrirModalNuevo()">
            Nueva Entrevista
        </button>

        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Entrevista</th>
                    <th>Oferente</th>
                    <th>Empleado</th>
                    <th>Fecha Entrevista</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.EntrevistasPaginadas)
                {
                    <tr>
                        <td>@item.EntrevistaId</td>
                        <td>@item.OferenteIdentificacion</td>
                        <td>@item.EmpleadoId</td>
                        <td>@item.FechaEntrevista.ToString("yyyy-MM-dd")</td>
                        <td>
                        <span class="badge @(item.Estado == "Realizada" ? "bg-success" : item.Estado == "Pendiente" ? "bg-secondary" : "bg-danger")"> @item.Estado </span>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-warning me-1"
                                onclick="abrirModalEditar(@item.EntrevistaId)">
                                <i class="bi bi-pencil"></i> Editar
                            </button>
                            <button type="button" class="btn btn-sm btn-danger me-1"
                                onclick="abrirModalEliminar(@item.EntrevistaId)">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>

                            @* Toggle Realizado/Pendiente*@
                            @if (item.Estado == "Realizada")
                            {
                                <form method="post" asp-page-handler="CambiarEstado" asp-route-u=@Request.Query["u"] style="display:inline">
                                    <input type="hidden" name="entrevistaId" value="@item.EntrevistaId" />
                                    <button type="submit" class="btn btn-sm btn-secondary me-1">
                                        Pendiente
                                    </button>
                                </form>
                            }
                            else if (item.Estado == "Pendiente")
                            {
                                <form method="post" asp-page-handler="CambiarEstado" asp-route-u=@Request.Query["u"] style="display:inline">
                                    <input type="hidden" name="entrevistaId" value="@item.EntrevistaId" />
                                    <button type="submit" class="btn btn-sm btn-success me-1">
                                        Realizada
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Paginación -->
        @if (Model.TotalPaginas > 1)
        {
            <div class="grid-pager">
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <a href="?pagina=@i&u=@Request.Query["u"]"
                       class="btn btn-sm @(i == Model.PaginaActual ? "btn-primary" : "btn-outline-secondary") me-1">
                        @i
                    </a>
                }
            </div>
        }

    </div>
</div>

<!-- ===== Modal Agregar / Editar ===== -->
<div id="modalEntrevista" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header card-header-custom text-white">
                <h5 class="modal-title" id="modalEntrevistaTitle">Formulario Entrevista</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" id="formEntrevista">
                <div class="modal-body">
                    <input type="hidden" id="hfAccion" name="Accion" value="0" />
                    <input type="hidden" id="hfEntrevistaIdForm" name="EntrevistaId" value="0" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">ID Entrevista</label>
                        <input type="text" id="txtEntrevistaId" class="form-control" disabled />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Oferente</label>
                        <!-- Hidden que siempre se envía en el POST; el select es solo visual -->
                        <input type="hidden" id="hfOferenteIdentificacion" name="OferenteIdentificacion" value="" />
                        <select id="ddlOferentes" class="form-select">
                            @foreach (var o in Model.Oferentes)
                            {
                                <option value="@o.Identificacion">@o.NombreCompleto</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Empleado</label>
                        <select id="ddlEmpleados" name="EmpleadoId" class="form-select">
                            @foreach (var emp in Model.Empleados)
                            {
                                <option value="@emp.EmpleadoId">@emp.NombreCompleto</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Fecha de entrevista</label>
                        <input type="date" id="txtFechaEntrevista" name="FechaEntrevista" class="form-control" />
                    </div>

                    <span id="lblMensajeError" class="form-label fw-semibold text-danger"></span>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== Modal Confirmar Eliminar ===== -->
<div id="modalEliminar" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Realmente desea eliminar el elemento seleccionado?</p>
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Eliminar" asp-route-u="@Request.Query["u"]">
                    <input type="hidden" id="hfEliminarId" name="entrevistaId" value="" />
                    <button type="submit" class="btn btn-danger">Si</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ===== Modal Mensaje Sistema ===== -->
<div id="modalMensaje" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Mensaje del sistema</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <span id="txtMensajeSistema">@Model.MensajeSistema</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const entrevistasData = @Html.Raw(Model.EntrevistasJson);

    // Sincroniza el hidden con el select visible cuando el usuario cambia la selección
    document.getElementById('ddlOferentes').addEventListener('change', function () {
        document.getElementById('hfOferenteIdentificacion').value = this.value;
    });

    function setOferente(valor, soloLectura) {
        const sel = document.getElementById('ddlOferentes');
        const hf  = document.getElementById('hfOferenteIdentificacion');
        sel.value = valor;
        hf.value  = valor;
        // "Solo lectura" visual: pointer-events none + fondo gris, pero el campo NO está disabled
        sel.style.pointerEvents = soloLectura ? 'none' : '';
        sel.style.backgroundColor = soloLectura ? '#e9ecef' : '';
    }

    function abrirModalNuevo() {
        document.getElementById('modalEntrevistaTitle').textContent = 'Nueva Entrevista';
        document.getElementById('hfAccion').value = '0';
        document.getElementById('hfEntrevistaIdForm').value = '0';
        document.getElementById('txtEntrevistaId').value = '';
        setOferente('', false);
        document.getElementById('ddlEmpleados').selectedIndex = 0;
        document.getElementById('txtFechaEntrevista').value = '';
        document.getElementById('lblMensajeError').textContent = '';
        document.getElementById('formEntrevista').action = '?handler=Guardar&u=@Request.Query["u"]';
        new bootstrap.Modal(document.getElementById('modalEntrevista')).show();
    }

    function abrirModalEditar(id) {
        const e = entrevistasData.find(x => x.entrevistaId === id);
        if (!e) return;

        document.getElementById('modalEntrevistaTitle').textContent = 'Editar Entrevista';
        document.getElementById('hfAccion').value = '1';
        document.getElementById('hfEntrevistaIdForm').value = e.entrevistaId;
        document.getElementById('txtEntrevistaId').value = e.entrevistaId;
        setOferente(e.oferenteIdentificacion, true);   // solo lectura visual, hidden sí se envía
        document.getElementById('ddlEmpleados').value = e.empleadoId;
        document.getElementById('txtFechaEntrevista').value = e.fechaEntrevista;
        document.getElementById('lblMensajeError').textContent = '';
        document.getElementById('formEntrevista').action = '?handler=Guardar&u=@Request.Query["u"]';
        new bootstrap.Modal(document.getElementById('modalEntrevista')).show();
    }

    function abrirModalEliminar(id) {
        document.getElementById('hfEliminarId').value = id;
        new bootstrap.Modal(document.getElementById('modalEliminar')).show();
    }

    window.addEventListener('DOMContentLoaded', function () {
        // Modal de mensaje del sistema (éxito, error del servidor)
        const msg = document.getElementById('txtMensajeSistema').textContent.trim();
        if (msg) {
            new bootstrap.Modal(document.getElementById('modalMensaje')).show();
        }

        // Re-abrir modal de entrevista si hubo error de validación en el POST
        const mostrar = '@Model.MostrarModalEntrevista';
        if (mostrar !== 'True') return;

        const accionVal = '@Model.AccionActual';
        const esEditar  = accionVal === '1';

        document.getElementById('modalEntrevistaTitle').textContent = esEditar ? 'Editar Entrevista' : 'Nueva Entrevista';
        document.getElementById('hfAccion').value             = accionVal;
        document.getElementById('hfEntrevistaIdForm').value   = '@Model.EntrevistaIdActual';
        document.getElementById('txtEntrevistaId').value      = '@Model.EntrevistaIdActual';
        setOferente('@Model.OferenteActual', esEditar);
        document.getElementById('ddlEmpleados').value         = '@Model.EmpleadoIdActual';
        document.getElementById('txtFechaEntrevista').value   = '@Model.FechaActual';
        document.getElementById('lblMensajeError').textContent = '@Model.MensajeError';
        document.getElementById('formEntrevista').action      = '?handler=Guardar&u=@Request.Query["u"]';
        new bootstrap.Modal(document.getElementById('modalEntrevista')).show();
    });
</script>
}