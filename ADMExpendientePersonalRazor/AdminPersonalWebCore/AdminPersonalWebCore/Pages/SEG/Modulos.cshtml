@page
@model AdminPersonalWebCore.Pages.SEG.ModulosModel

@{
    ViewData["Title"] = "Administración de Módulos";

    var tieneMensaje = !string.IsNullOrWhiteSpace(Model.MensajeExito) ||
                       !string.IsNullOrWhiteSpace(Model.MensajeError);

    var tituloModalMensaje = !string.IsNullOrWhiteSpace(Model.MensajeExito)
        ? "Operación exitosa"
        : "Mensaje del sistema";

    var claseHeaderModal = !string.IsNullOrWhiteSpace(Model.MensajeExito)
        ? "bg-success text-white"
        : "bg-danger text-white";

    var mensajeModal = !string.IsNullOrWhiteSpace(Model.MensajeExito)
        ? Model.MensajeExito
        : Model.MensajeError;
}

<div class="card-custom bg-white">

    <div class="card-header-custom">
        <h5 class="fw-bold mb-0">Administración de Módulos</h5>
    </div>

    <div class="p-4">

        <button type="button"
                class="btn btn-primary mb-3 fw-semibold"
                data-bs-toggle="modal"
                data-bs-target="#modalModulo">
            Nuevo
        </button>

        <div class="table-responsive">

            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>ID Módulo</th>
                        <th>Nombre del módulo</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Modulos)
                    {
                        <tr>
                            <td>@item.id_modulo</td>
                            <td>@item.nombre_modulo</td>
                            <td>
                                <a class="btn btn-warning btn-sm me-1"
                                   asp-page="./Modulos"
                                   asp-route-editarId="@item.id_modulo"
                                   asp-route-pagina="@Model.PaginaActual"
                                   asp-route-u="@Request.Query["u"]">
                                    Editar
                                </a>

                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEliminar"
                                        data-id="@item.id_modulo"
                                        data-nombre="@item.nombre_modulo">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.TotalPaginas > 1)
            {
                <nav aria-label="Paginación de módulos">
                    <ul class="pagination justify-content-center mt-3">

                        <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="./Modulos"
                               asp-route-pagina="@(Model.PaginaActual - 1)"
                               asp-route-u="@Request.Query["u"]">
                                Anterior
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPaginas; i++)
                        {
                            <li class="page-item @(Model.PaginaActual == i ? "active" : "")">
                                <a class="page-link"
                                   asp-page="./Modulos"
                                   asp-route-pagina="@i"
                                   asp-route-u="@Request.Query["u"]">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="./Modulos"
                               asp-route-pagina="@(Model.PaginaActual + 1)"
                               asp-route-u="@Request.Query["u"]">
                                Siguiente
                            </a>
                        </li>

                    </ul>
                </nav>
            }

        </div>

    </div>

</div>

<!-- Modal Crear / Editar -->
<div class="modal fade" id="modalModulo" tabindex="-1" aria-labelledby="modalModuloLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form method="post"
                  asp-page-handler="Guardar"
                  asp-route-u="@Request.Query["u"]">

                @Html.AntiForgeryToken()

                <div class="modal-header"
                     style="background:#1aad94; color:white;">

                    <h5 class="modal-title" id="modalModuloLabel">
                        @(Model.Modulo.id_modulo == 0 ? "Nuevo módulo" : "Editar módulo")
                    </h5>

                    <a asp-page="./Modulos"
                       asp-route-u="@Request.Query["u"]"
                       class="btn-close btn-close-white"></a>
                </div>

                <div class="modal-body">
                    <input type="hidden" asp-for="Modulo.id_modulo" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Nombre del módulo
                        </label>

                        <input asp-for="Modulo.nombre_modulo"
                               class="form-control"
                               maxlength="100"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Roles asociados
                        </label>

                        @foreach (var rol in Model.Roles)
                        {
                            bool seleccionado = Model.RolesSeleccionadosEdicion.Contains(rol.id_rol);

                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="RolesSeleccionados"
                                       value="@rol.id_rol"
                                       id="rol_@rol.id_rol"
                                       checked="@seleccionado" />

                                <label class="form-check-label" for="rol_@rol.id_rol">
                                    @rol.nombre_rol
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        Guardar
                    </button>

                    <a asp-page="./Modulos"
                       asp-route-u="@Request.Query["u"]"
                       class="btn btn-secondary">
                        Cerrar
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form method="post"
                  asp-page-handler="Eliminar"
                  asp-route-u="@Request.Query["u"]">

                @Html.AntiForgeryToken()

                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="modalEliminarLabel">
                        Confirmar eliminación
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="idModulo" id="idModuloEliminar" />

                    <p>¿Realmente desea eliminar el elemento seleccionado?</p>
                    <strong id="nombreModuloEliminar"></strong>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">
                        Sí
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        No
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@if (tieneMensaje)
{
    <div class="modal fade"
         id="modalMensajeSistema"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header @claseHeaderModal">

                    <h5 class="modal-title fw-bold">
                        @tituloModalMensaje
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">
                    @mensajeModal
                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Aceptar
                    </button>

                </div>

            </div>

        </div>

    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const modalEliminar = document.getElementById('modalEliminar');

            if (modalEliminar) {
                modalEliminar.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;

                    const id = button.getAttribute('data-id');
                    const nombre = button.getAttribute('data-nombre');

                    document.getElementById('idModuloEliminar').value = id;
                    document.getElementById('nombreModuloEliminar').textContent = nombre;
                });
            }

            const idModulo = '@Model.Modulo.id_modulo';
            const hayError = '@Model.MensajeError';

            if (idModulo !== '0' || hayError) {
                const modalModulo = document.getElementById('modalModulo');

                if (modalModulo) {
                    const modal = new bootstrap.Modal(modalModulo);
                    modal.show();
                }
            }

            const modalMensaje = document.getElementById('modalMensajeSistema');

            if (modalMensaje) {
                new bootstrap.Modal(modalMensaje).show();
            }
        });
    </script>
}