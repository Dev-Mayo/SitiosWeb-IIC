@page
@model AdminPersonalWebCore.Pages.SEG.AdminRolesModel
@{
    ViewData["Title"] = "Administración de Roles";
}

<style>
    .card-custom {
        border-radius: 14px;
        box-shadow: 0 6px 28px rgba(0,0,0,.15);
        overflow: hidden;
    }

    .card-header-custom {
        background: #1aad94;
        padding: 20px;
        text-align: center;
        color: white;
    }

    .table {
        width: 100%;
    }
</style>

<div class="card-custom bg-white">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0">Administración de Roles</h5>
    </div>

    <div class="p-4">
        <a asp-page="AdminRolesForm" asp-route-u="@Request.Query["u"]" class="btn btn-primary mb-3 fw-semibold">Nuevo</a>

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rol in Model.Roles)
                {
                    <tr>
                        <td>@rol.id_rol</td>
                        <td>@rol.nombre_rol</td>
                        <td>
                            <a asp-page="AdminRolesForm" asp-route-id="@rol.id_rol" asp-route-u="@Request.Query["u"]" class="btn btn-sm btn-warning me-2">
                                <i class="bi bi-pencil"></i> Editar
                            </a>

                                <button type="button" class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEliminar"
                                        data-id="@rol.id_rol">
                                    <i class="bi bi-trash"></i> Eliminar
                                </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-page="AdminRoles" asp-route-pageIndex="@i" asp-route-u="@Request.Query["u"]">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

<!-- Modal Mensaje -->
<div class="modal fade" id="modalMensaje" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Mensaje del sistema</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="mensajeModal">@TempData["ModalMensaje"]</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>



<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Está seguro que desea eliminar este rol?</p>
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Eliminar">
                    <input type="hidden" id="hfIdRol" name="id" />
                    <input type="hidden" name="u" value="@Request.Query["u"]" />
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                </form>
            </div>
        </div>
    </div>
</div>


<script>
    var modalEliminar = document.getElementById('modalEliminar');
    modalEliminar.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var idRol = button.getAttribute('data-id');
        document.getElementById('hfIdRol').value = idRol;
    });

      function mostrarModalError(mensaje) {
      const mensajeEl = document.getElementById('mensajeModal');
      mensajeEl.textContent = mensaje;

      // Crear instancia del modal y mostrarlo
      const modalEl = document.getElementById('modalMensaje');
      const bsModal = new bootstrap.Modal(modalEl);
      bsModal.show();
    }
        window.addEventListener('DOMContentLoaded', function () {
        var mensaje = "@TempData["ModalMensaje"]";
        if (mensaje && mensaje.trim() !== "") {
            mostrarModalError(mensaje);
        }
    });
</script>

