@page
@model AdminPersonalWebCore.Pages.SEG.AdminRolesModel
@{
    ViewData["Title"] = "Administración de Roles";
}

<style>
    .card-custom {
        border-radius: 14px;
        box-shadow: 0 6px 28px rgba(0,0,0,.15);
        overflow: hidden;
    }
    .card-header-custom {
        background: #1aad94;
        padding: 20px;
        text-align: center;
        color: white;
    }
    .table { width: 100%; }
</style>

<div class="card-custom bg-white">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0">Administración de Roles</h5>
    </div>

    <div class="p-4">
        <button type="button" class="btn btn-primary mb-3 fw-semibold" onclick="abrirModalNuevo()">
            <i class="bi bi-plus-lg"></i> Nuevo
        </button>

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rol in Model.Roles)
                {
                    <tr>
                        <td>@rol.id_rol</td>
                        <td>@rol.nombre_rol</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-warning me-2"
                                onclick="abrirModalEditar(@rol.id_rol, '@Html.Raw(rol.nombre_rol.Replace("'", "\\'"))')">
                                <i class="bi bi-pencil"></i> Editar
                            </button>
                            <button type="button" class="btn btn-sm btn-danger"
                                onclick="abrirModalEliminar(@rol.id_rol)">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </td>
                    </tr>
                }
                @if (!Model.Roles.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted fst-italic py-3">
                            No hay roles registrados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link"
                           asp-page="AdminRoles"
                           asp-route-pageIndex="@i"
                           asp-route-u="@Request.Query["u"]">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

<!-- ===== Modal Agregar / Editar ===== -->
<div id="modalRol" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header card-header-custom text-white">
                <h5 class="modal-title" id="modalRolTitle">Formulario Rol</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" id="formRol">
                <div class="modal-body">
                    <input type="hidden" id="hfRolId" name="rolId" value="0" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">ID del rol</label>
                        <input type="text" id="txtRolId" class="form-control" disabled />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre del rol</label>
                        <input type="text" id="txtNombreRol" name="nombreRol" class="form-control"
                               maxlength="40" placeholder="Nombre del rol" />
                    </div>

                    <span id="lblMensajeError" class="form-label fw-semibold text-danger"></span>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-floppy"></i> Guardar
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== Modal Confirmar Eliminar ===== -->
<div id="modalEliminar" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Está seguro que desea eliminar este rol?</p>
            </div>
            <div class="modal-footer">
                <form method="post" id="formEliminar">
                    <input type="hidden" id="hfEliminarId" name="id" value="" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Eliminar
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ===== Modal Mensaje Sistema ===== -->
<div id="modalMensaje" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Mensaje del sistema</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <span id="txtMensajeSistema">@TempData["ModalMensaje"]</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const u = '@Request.Query["u"]';

    function abrirModalNuevo() {
        document.getElementById('modalRolTitle').textContent      = 'Nuevo Rol';
        document.getElementById('hfRolId').value                  = '0';
        document.getElementById('txtRolId').value                 = '';
        document.getElementById('txtNombreRol').value             = '';
        document.getElementById('lblMensajeError').textContent    = '';
        document.getElementById('formRol').action                 = `?handler=Guardar&u=${u}`;
        new bootstrap.Modal(document.getElementById('modalRol')).show();
    }

    function abrirModalEditar(id, nombre) {
        document.getElementById('modalRolTitle').textContent      = 'Editar Rol';
        document.getElementById('hfRolId').value                  = id;
        document.getElementById('txtRolId').value                 = id;
        document.getElementById('txtNombreRol').value             = nombre;
        document.getElementById('lblMensajeError').textContent    = '';
        document.getElementById('formRol').action                 = `?handler=Guardar&u=${u}`;
        new bootstrap.Modal(document.getElementById('modalRol')).show();
    }

    function abrirModalEliminar(id) {
        document.getElementById('hfEliminarId').value             = id;
        document.getElementById('formEliminar').action            = `?handler=Eliminar&u=${u}`;
        new bootstrap.Modal(document.getElementById('modalEliminar')).show();
    }

    window.addEventListener('DOMContentLoaded', function () {
        // Error de validación: el POST devolvió Page() directamente con MostrarModalForm=true
        // Esto NUNCA ocurre en un GET normal, solo tras un POST fallido
        const mostrar = '@Model.MostrarModalForm' === 'True';
        if (mostrar) {
            const rolId    = '@Model.RolIdActual';
            const nombre   = '@Html.Raw(Model.NombreRolActual.Replace("'", "\\'"))';
            const esEditar = parseInt(rolId) > 0;

            document.getElementById('modalRolTitle').textContent   = esEditar ? 'Editar Rol' : 'Nuevo Rol';
            document.getElementById('hfRolId').value               = rolId;
            document.getElementById('txtRolId').value              = esEditar ? rolId : '';
            document.getElementById('txtNombreRol').value          = nombre;
            document.getElementById('lblMensajeError').textContent = '@Model.MensajeError';
            document.getElementById('formRol').action              = `?handler=Guardar&u=${u}`;
            new bootstrap.Modal(document.getElementById('modalRol')).show();
            return; // no abrir modal de mensaje si ya abrimos el de form
        }

        // Mensaje de sistema (éxito, error de servidor) — solo en GET tras redirect
        const msg = document.getElementById('txtMensajeSistema').textContent.trim();
        if (msg) {
            new bootstrap.Modal(document.getElementById('modalMensaje')).show();
        }
    });
</script>
}
