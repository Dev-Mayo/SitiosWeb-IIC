@page "{id?}"
@model AdminPersonalWebCore.Pages.SEG.AdminRolesFormModel
@{
    ViewData["Title"] = Model.EsEdicion ? "Editar Rol" : "Crear Rol";
}

<style>
    .card-custom {
        width: calc(100% - 80px);
        max-width: none;
        margin: 40px;
        border-radius: 14px;
        box-shadow: 0 6px 28px rgba(0,0,0,.15);
    }

    .card-header-custom {
        background: #1aad94;
        padding: 20px;
        text-align: center;
        color: white;
    }
</style>

<div class="card-custom bg-white">
    <div class="card-header-custom text-white">
        <h5 class="fw-bold mb-0">@ViewData["Title"]</h5>
    </div>

    <input type="hidden" name="u" value="@Request.Query["u"]" />

    <div class="p-4">
        <form method="post">

            <div class="mb-3">
                <label class="form-label fw-semibold">ID del rol</label>
                <input asp-for="Rol.id_rol" class="form-control no-select" readonly />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Nombre del rol</label>
                <input asp-for="Rol.nombre_rol" class="form-control" />
                <span asp-validation-for="Rol.nombre_rol" class="text-danger"></span>
            </div>

            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-page="AdminRoles" asp-route-u="@Request.Query["u"]" class="btn btn-secondary">Cerrar</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
