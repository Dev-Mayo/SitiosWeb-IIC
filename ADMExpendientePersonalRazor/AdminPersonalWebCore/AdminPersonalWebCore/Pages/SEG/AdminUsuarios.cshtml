@page
@model AdminPersonalWebCore.Pages.SEG.AdminUsuariosModel
@{
    ViewData["Title"] = "Administración de Usuarios";
}

@section Styles {
    <style>
        .card-custom {
            border-radius: 14px;
            box-shadow: 0 6px 28px rgba(0,0,0,.15);
            overflow: hidden;
        }

        .card-header-custom {
            background: #1aad94;
            padding: 20px;
            text-align: center;
            color: white;
        }

        .table {
            width: 100%;
        }
    </style>
}

<div class="card-custom bg-white">
    <div class="card-header-custom">
        <h5 class="fw-bold mb-0">Administración de Usuarios</h5>
    </div>

    <div class="p-4">

        @* Success / Error message *@
        @if (!string.IsNullOrEmpty(Model.MensajeExito))
        {
            <div class="alert alert-success alert-dismissible fade show">
                @Model.MensajeExito
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.MensajeError))
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @Model.MensajeError
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <button type="button" class="btn btn-primary mb-3 fw-semibold"
                data-bs-toggle="modal" data-bs-target="#modalNuevo"
                onclick="limpiarModalNuevo()">
            Nuevo
        </button>

        @* TABLE *@
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Usuario</th>
                        <th>Nombre Completo</th>
                        <th>Correo</th>
                        <th>Roles</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Usuarios)
                    {
                        <tr>
                            <td>@u.id_usuario</td>
                            <td>@u.nombreusuario</td>
                            <td>@u.nombre_completo</td>
                            <td>@u.correo</td>
                            <td>@u.roles</td>
                            <td>
                                <span class="badge @(u.estado == "Activo" ? "bg-success" :
                                                                          u.estado == "Inactivo" ? "bg-secondary" : "bg-danger")">
                                @u.estado
                            </span>
                        </td>
                        <td>
                            @* Edit *@
                            <button type="button" class="btn btn-sm btn-warning me-1"
                                    onclick="abrirEditar(@u.id_usuario, '@u.nombreusuario',
                                            '@u.nombre_completo', '@u.correo',
                                            '@u.estado', '@u.id_roles')">
                                Editar
                            </button>

                                @* Toggle Activo/Inactivo *@
                            @if (u.estado == "Activo")
                                {
                                    <form method="post" asp-page-handler="CambiarEstado" asp-route-u="@Model.UsuarioActual">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idUsuario" value="@u.id_usuario" />
                                        <input type="hidden" name="nuevoEstado" value="Inactivo" />
                                        <button type="submit" class="btn btn-sm btn-secondary me-1">
                                            Inactivar
                                        </button>
                                    </form>
                                }
                                else if (u.estado == "Inactivo")
                                {
                                    <form method="post" asp-page-handler="CambiarEstado" asp-route-u="@Model.UsuarioActual">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idUsuario" value="@u.id_usuario" />
                                        <input type="hidden" name="nuevoEstado" value="Activo" />
                                        <button type="submit" class="btn btn-sm btn-success me-1">
                                            Activar
                                        </button>
                                    </form>
                                }

                                @* Delete *@
                                <button type="button" class="btn btn-sm btn-danger"
                                        onclick="confirmarEliminar(@u.id_usuario)">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Pagination *@
        @if (Model.TotalPaginas > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                            <a class="page-link"
                               href="/SEG/AdminUsuarios?u=@Model.UsuarioActual&page=@i">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }

    </div>
</div>

@* ── MODAL NUEVO ── *@
<div class="modal fade" id="modalNuevo" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:#1aad94; color:white;">
                <h5 class="modal-title">Nuevo Usuario</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Crear" asp-route-u="@Model.UsuarioActual">
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    @if (!string.IsNullOrEmpty(Model.ErrorNuevo))
                    {
                        <div class="alert alert-danger">@Model.ErrorNuevo</div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre de usuario</label>
                        <input type="text" name="username" class="form-control"
                               maxlength="50" required value="@Model.FormUsername" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre completo</label>
                        <input type="text" name="nombreCompleto" class="form-control"
                               maxlength="100" required value="@Model.FormNombreCompleto" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Correo</label>
                        <input type="email" name="correo" class="form-control"
                               maxlength="100" required value="@Model.FormCorreo" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Contraseña</label>
                        <input type="password" name="password" class="form-control" required />
                        <small class="text-muted">
                            Mínimo 8 caracteres, mayúsculas, minúsculas, números y caracteres especiales.
                        </small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Confirmar contraseña</label>
                        <input type="password" name="confirmarPassword" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Roles</label>
                        @foreach (var rol in Model.Roles)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="roles" value="@rol.id_rol"
                                       id="rol_@rol.id_rol" />
                                <label class="form-check-label" for="rol_@rol.id_rol">
                                    @rol.nombre_rol
                                </label>
                            </div>
                        }
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cerrar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── MODAL EDITAR ── *@
<div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:#1aad94; color:white;">
                <h5 class="modal-title">Editar Usuario</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Editar" asp-route-u="@Model.UsuarioActual">
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    @if (!string.IsNullOrEmpty(Model.ErrorEditar))
                    {
                        <div class="alert alert-danger">@Model.ErrorEditar</div>
                    }

                    <input type="hidden" id="editIdUsuario" name="idUsuario" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre de usuario</label>
                        <input type="text" id="editUsername" name="username"
                               class="form-control" maxlength="50" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre completo</label>
                        <input type="text" id="editNombreCompleto" name="nombreCompleto"
                               class="form-control" maxlength="100" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Correo</label>
                        <input type="email" id="editCorreo" name="correo"
                               class="form-control" maxlength="100" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Contraseña <small class="text-muted">(dejar vacío para no cambiar)</small>
                        </label>
                        <input type="password" name="password" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Confirmar contraseña</label>
                        <input type="password" name="confirmarPassword" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Estado</label>
                        <select id="editEstado" name="estado" class="form-select">
                            <option value="Activo">Activo</option>
                            <option value="Inactivo">Inactivo</option>
                            <option value="Bloqueado">Bloqueado</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Roles</label>
                        @foreach (var rol in Model.Roles)
                        {
                            <div class="form-check">
                                <input class="form-check-input edit-rol-check"
                                       type="checkbox" name="roles"
                                       value="@rol.id_rol"
                                       id="editRol_@rol.id_rol" />
                                <label class="form-check-label" for="editRol_@rol.id_rol">
                                    @rol.nombre_rol
                                </label>
                            </div>
                        }
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cerrar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── MODAL ELIMINAR ── *@
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Realmente desea eliminar el elemento seleccionado?</p>
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Eliminar" asp-route-u="@Model.UsuarioActual">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="eliminarIdUsuario" name="idUsuario" />
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        function abrirEditar(id, username, nombre, correo, estado, idRoles) {
            document.getElementById('editIdUsuario').value      = id;
            document.getElementById('editUsername').value       = username;
            document.getElementById('editNombreCompleto').value = nombre;
            document.getElementById('editCorreo').value         = correo;
            document.getElementById('editEstado').value         = estado;


            const roles = idRoles ? idRoles.split(',').map(r => r.trim()) : [];
            document.querySelectorAll('.edit-rol-check').forEach(cb => {
                cb.checked = roles.includes(cb.value);
            });

            new bootstrap.Modal(document.getElementById('modalEditar')).show();
        }

        function confirmarEliminar(id) {
            document.getElementById('eliminarIdUsuario').value = id;
            new bootstrap.Modal(document.getElementById('modalEliminar')).show();
        }

        function limpiarModalNuevo() {
            document.querySelectorAll('#modalNuevo input[type=text],' +
                '#modalNuevo input[type=email],' +
                '#modalNuevo input[type=password]')
                .forEach(el => el.value = '');
            document.querySelectorAll('#modalNuevo input[type=checkbox]')
                .forEach(el => el.checked = false);
        }


        @if (!string.IsNullOrEmpty(Model.ErrorNuevo))
        {
                <text>
                document.addEventListener('DOMContentLoaded', function() {
                    new bootstrap.Modal(document.getElementById('modalNuevo')).show();
                });
                </text>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorEditar))
        {
                <text>
                document.addEventListener('DOMContentLoaded', function() {
                    new bootstrap.Modal(document.getElementById('modalEditar')).show();
                });
                </text>
        }
    </script>
}