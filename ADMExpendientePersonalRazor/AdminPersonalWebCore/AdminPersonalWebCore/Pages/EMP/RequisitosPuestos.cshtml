@page
@model AdminPersonalWebCore.Pages.EMP.RequisitosPuestosModel

@{
    ViewData["Title"] = "Administración de Requisitos de Puestos";

    var tieneMensaje = !string.IsNullOrEmpty(Model.MensajeExito) ||
                       !string.IsNullOrEmpty(Model.MensajeError);

    var tituloModalMensaje = !string.IsNullOrEmpty(Model.MensajeExito)
        ? "Operación exitosa"
        : "Mensaje del sistema";

    var claseHeaderModal = !string.IsNullOrEmpty(Model.MensajeExito)
        ? "bg-success text-white"
        : "bg-danger text-white";

    var mensajeModal = !string.IsNullOrEmpty(Model.MensajeExito)
        ? Model.MensajeExito
        : Model.MensajeError;
}

<div class="card-custom bg-white">

    <div class="card-header-custom">
        <h5 class="fw-bold mb-0">
            Administración de Requisitos de Puestos
        </h5>
    </div>

    <div class="p-4">

        <button type="button"
                class="btn btn-primary mb-3 fw-semibold"
                data-bs-toggle="modal"
                data-bs-target="#modalNuevo">
            Nuevo
        </button>

        <div class="table-responsive">

            <table class="table table-striped table-bordered">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var requisito in Model.Requisitos)
                    {
                        <tr>

                            <td>@requisito.requisito_id</td>

                            <td>@requisito.nombre</td>

                            <td>

                                <button type="button"
                                        class="btn btn-sm btn-warning me-1"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEditar"
                                        data-id="@requisito.requisito_id"
                                        data-nombre="@requisito.nombre">
                                    Editar
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEliminar"
                                        data-id="@requisito.requisito_id"
                                        data-nombre="@requisito.nombre">
                                    Eliminar
                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            @if (Model.TotalPaginas > 1)
            {
                <nav aria-label="Paginación de requisitos">
                    <ul class="pagination justify-content-center mt-3">

                        <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="./RequisitosPuestos"
                               asp-route-pagina="@(Model.PaginaActual - 1)"
                               asp-route-u="@Request.Query["u"]">
                                Anterior
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPaginas; i++)
                        {
                            <li class="page-item @(Model.PaginaActual == i ? "active" : "")">
                                <a class="page-link"
                                   asp-page="./RequisitosPuestos"
                                   asp-route-pagina="@i"
                                   asp-route-u="@Request.Query["u"]">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="./RequisitosPuestos"
                               asp-route-pagina="@(Model.PaginaActual + 1)"
                               asp-route-u="@Request.Query["u"]">
                                Siguiente
                            </a>
                        </li>

                    </ul>
                </nav>
            }

        </div>

    </div>

</div>

<!-- Modal Nuevo -->
<div class="modal fade"
     id="modalNuevo"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header"
                 style="background:#1aad94; color:white;">

                <h5 class="modal-title">
                    Nuevo Requisito de Puesto
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form method="post"
                  asp-page-handler="Crear"
                  asp-route-u="@Request.Query["u"]">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Nombre del requisito
                        </label>

                        <input type="text"
                               name="nombre"
                               class="form-control"
                               maxlength="100"
                               required />

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cerrar
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- Modal Editar -->
<div class="modal fade"
     id="modalEditar"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header"
                 style="background:#ffc107; color:#000;">

                <h5 class="modal-title">
                    Editar Requisito de Puesto
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form method="post"
                  asp-page-handler="Editar"
                  asp-route-u="@Request.Query["u"]">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden"
                           id="editarRequisitoId"
                           name="requisito_id" />

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Nombre del requisito
                        </label>

                        <input type="text"
                               id="editarNombre"
                               name="nombre"
                               class="form-control"
                               maxlength="100"
                               required />

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar cambios
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cerrar
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- Modal Eliminar -->
<div class="modal fade"
     id="modalEliminar"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title">
                    Confirmar eliminación
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form method="post"
                  asp-page-handler="Eliminar"
                  asp-route-u="@Request.Query["u"]">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden"
                           id="eliminarId"
                           name="id" />

                    <p>
                        ¿Realmente desea eliminar el elemento seleccionado?
                    </p>

                    <strong id="eliminarNombre"></strong>

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            class="btn btn-danger">
                        Sí
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        No
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@if (tieneMensaje)
{
    <div class="modal fade"
         id="modalMensajeSistema"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header @claseHeaderModal">

                    <h5 class="modal-title fw-bold">
                        @tituloModalMensaje
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">
                    @mensajeModal
                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Aceptar
                    </button>

                </div>

            </div>

        </div>

    </div>
}

@section Scripts {
    <script>
        const modalEditar = document.getElementById('modalEditar');

        if (modalEditar) {
            modalEditar.addEventListener('show.bs.modal', function (event) {
                const boton = event.relatedTarget;

                const id = boton.getAttribute('data-id');
                const nombre = boton.getAttribute('data-nombre');

                document.getElementById('editarRequisitoId').value = id;
                document.getElementById('editarNombre').value = nombre;
            });
        }
    </script>

    <script>
        const modalEliminar = document.getElementById('modalEliminar');

        if (modalEliminar) {
            modalEliminar.addEventListener('show.bs.modal', function (event) {
                const boton = event.relatedTarget;

                const id = boton.getAttribute('data-id');
                const nombre = boton.getAttribute('data-nombre');

                document.getElementById('eliminarId').value = id;
                document.getElementById('eliminarNombre').innerText = nombre;
            });
        }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modalMensaje = document.getElementById("modalMensajeSistema");

            if (modalMensaje) {
                new bootstrap.Modal(modalMensaje).show();
            }
        });
    </script>
}