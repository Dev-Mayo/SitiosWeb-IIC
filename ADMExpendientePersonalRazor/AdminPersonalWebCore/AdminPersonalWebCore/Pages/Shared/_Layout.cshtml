<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Administración de Personal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)
    <style>
        body { margin: 0; padding: 0; background: #f0f2f5; }
        .sidebar {
            min-height: 100vh;
            background-color: #1aad94;
            width: 220px;
            position: fixed;
            top: 0; left: 0;
            display: flex;
            flex-direction: column;
            padding: 20px 12px;
            z-index: 100;
        }
        .sidebar .brand { text-align: center; color: white; margin-bottom: 16px; }
        .sidebar .brand img { max-width: 70px; border-radius: 8px; }
        .sidebar .brand h5 { margin-top: 8px; font-weight: 700; }
        .sidebar hr { border-color: rgba(255,255,255,0.3); }
        .sidebar .nav-link {
            color: white !important;
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 0.9rem;
        }
        .sidebar .nav-link:hover { background: rgba(255,255,255,0.15); }
        .sidebar .section-label {
            color: rgba(255,255,255,0.6);
            font-size: 0.7rem;
            text-transform: uppercase;
            margin-top: 12px;
            padding-left: 10px;
        }
        .main-content { margin-left: 220px; min-height: 100vh; }
        .topbar {
            background: white;
            padding: 12px 24px;
            border-bottom: 1px solid #dee2e6;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 99;
        }
        .topbar .user-info { display: flex; align-items: center; gap: 10px; }
        .topbar .avatar {
            width: 38px; height: 38px;
            border-radius: 50%;
            background: #1aad94;
            color: white;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 1rem;
        }
        .page-body { padding: 28px; }

        .card-custom {
            border-radius: 14px;
            box-shadow: 0 6px 28px rgba(0,0,0,.15); /* agregue esto para que sea globall */
            overflow: hidden;
        }

        .card-header-custom {
            background: #1aad94;
            padding: 20px;         /* agregue esto para que sea globall */
            text-align: center;
            color: white;
        }

        /* Inactivity warning bar */
        #inactivityBar {
            display: none;
            position: fixed;
            bottom: 20px; right: 20px;
            z-index: 9999;
            min-width: 320px;
        }
    </style>
</head>
<body>

    @{
        var u = Context.Request.Query["u"].ToString();
        var nombreUser = Context.Session.GetString("nombre_completo") ?? u;
        var initials = string.IsNullOrEmpty(nombreUser) ? "U"
        : string.Concat(nombreUser.Split(' ')
        .Where(w => w.Length > 0)
        .Take(2)
        .Select(w => w[0].ToString().ToUpper()));

        // Load menu modules from session
        var modulosJson = Context.Session.GetString("modulos");
        var modulos = string.IsNullOrEmpty(modulosJson)
        ? new List<string>()
        : System.Text.Json.JsonSerializer.Deserialize<List<string>>(modulosJson);
    }

    <div class="d-flex">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="brand">
                <img src="/img/logoempresa.jpg" alt="Logo" onerror="this.style.display='none'" />
                <h5>Shirofy</h5>
            </div>

            <hr />

            <nav class="nav flex-column">
                @if (modulos.Contains("Inicio"))
                {
                    <a class="nav-link" href="/SEG/Bienvenida?u=@u">Inicio</a>
                }

                @if (modulos.Any(m => new[] { "Roles", "Pantallas", "Usuarios" }.Contains(m)))
                {
                    <span class="section-label">Seguridad</span>
                    @if (modulos.Contains("Roles"))
                    {
                        <a class="nav-link" href="/SEG/AdminRoles?u=@u">Roles</a>
                    }
                    @if (modulos.Contains("Pantallas"))
                    {
                        <a class="nav-link" href="/SEG/AdminPantallas?u=@u">Pantallas</a>
                    }
                    @if (modulos.Contains("Usuarios"))
                    {
                        <a class="nav-link" href="/SEG/AdminUsuarios?u=@u">Usuarios</a>
                    }
                }

                @if (modulos.Any(m => new[] { "Oferentes", "Concursos", "Entrevistas" }.Contains(m)))
                {
                    <span class="section-label">Oferentes</span>
                    @if (modulos.Contains("Oferentes"))
                    {
                        <a class="nav-link" href="/OFE/MainOferentes?u=@u">Oferentes</a>
                    }
                    @if (modulos.Contains("Concursos"))
                    {
                        <a class="nav-link" href="/OFE/AdminConcursos?u=@u">Concursos</a>
                    }
                    @if (modulos.Contains("Entrevistas"))
                    {
                        <a class="nav-link" href="/OFE/AgendarEntrevista?u=@u">Agendar Entrevista</a>
                    }
                }

                @if (modulos.Any(m => new[] { "Contratar empleado", "Puestos", "Áreas", "Acciones Personal" }.Contains(m)))
                {
                    
                    <span class="section-label">Empleados</span>
                    @if (modulos.Contains("Contratar Empleado"))
                    {
                        <a class="nav-link" href="/EMP/ContratarEmpleado?u=@u">Contratar Empleado</a>
                    }
                    @if (modulos.Contains("Puestos"))
                    {
                        <a class="nav-link" href="/EMP/AdminPuestos?u=@u">Puestos</a>
                    }
                    @if (modulos.Contains("Áreas"))
                    {
                        <a class="nav-link" href="/EMP/Areas?u=@u">Áreas</a>
                    }
                    @if (modulos.Contains("Acciones Personal"))
                    {
                        <a class="nav-link" href="/EMP/AccionesPersonal?u=@u">Acciones de Personal</a>
                    }
                }

                @if (modulos.Any(m => new[] { "Bitácora", "Parámetros", "Compañías", "Ubicaciones", "Inst. Educativas" }.Contains(m)))
                {
                    <span class="section-label">General</span>
                    @if (modulos.Contains("Bitácora"))
                    {
                        <a class="nav-link" href="/GEN/VerBitacoras?u=@u">Bitácora</a>
                    }
                    @if (modulos.Contains("Parámetros"))
                    {
                        <a class="nav-link" href="/GEN/AdminParametros?u=@u">Parámetros</a>
                    }
                    @if (modulos.Contains("Compañías"))
                    {
                        <a class="nav-link" href="/GEN/AdminCompanias?u=@u">Compañías</a>
                    }
                    @if (modulos.Contains("Ubicaciones"))
                    {
                        <a class="nav-link" href="/GEN/AdminUbicaciones?u=@u">Cargar Ubicaciones</a>
                    }
                    @if (modulos.Contains("Inst. Educativas"))
                    {
                        <a class="nav-link" href="/GEN/AdminInsEducativas?u=@u">Inst. Educativas</a>
                    }
                }

                <hr />
                <a class="nav-link btn btn-danger btn-sm mt-2 text-center" href="/SEG/Logout">
                    Cerrar sesión
                </a>
            </nav>

        </aside>

        <!-- MAIN -->
        <div class="main-content w-100">

            <!-- TOPBAR -->
            <div class="topbar">
                <h5 class="mb-0 fw-semibold">Sistema de Administración de Personal</h5>
                <div class="user-info">
                    <span class="fw-semibold">@nombreUser</span>
                    <div class="avatar">@initials</div>
                </div>
            </div>

            <!-- PAGE CONTENT -->
            <div class="page-body">
                @RenderBody()
            </div>

        </div>
    </div>

    <!-- SEG7 — Inactivity warning -->
    <div id="inactivityBar" class="alert alert-warning shadow">
        Su sesión está por expirar por inactividad.
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

    <script>
        (function () {
            const TIMEOUT_MS = 5 * 60 * 1000;
            const WARNING_MS = 4 * 60 * 1000;
            let timerWarning, timerLogout;

            function resetTimers() {
                clearTimeout(timerWarning);
                clearTimeout(timerLogout);
                timerWarning = setTimeout(showWarning, WARNING_MS);
                timerLogout  = setTimeout(forceLogout, TIMEOUT_MS);
            }

            function showWarning() {
                document.getElementById('inactivityBar').style.display = 'block';
            }

            function forceLogout() {
                window.location.href = '/SEG/Login?msg=expirado';
            }

            ['mousemove','keypress','click','scroll','touchstart']
                .forEach(ev => document.addEventListener(ev, resetTimers));

            resetTimers();
        })();
    </script>

</body>
</html>