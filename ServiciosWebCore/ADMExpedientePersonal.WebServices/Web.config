		<add name="GEN" connectionString="server=mysql-admin-personal-iic-2026-admin-personal-iic-2026.k.aivencloud.com;database=GEN;uid=avnadmin;pwd=AVNS_D9NXIT8nECYcHW1YV31;Port=16341;SslMode=Required;" providerName="MySql.Data.MySqlClient" />

		<add name="EMP" connectionString="server=mysql-admin-personal-iic-2026-admin-personal-iic-2026.k.aivencloud.com;database=EMP;uid=avnadmin;pwd=AVNS_D9NXIT8nECYcHW1YV31;Port=16341;SslMode=Required;" providerName="MySql.Data.MySqlClient" />
		<add name="OFE" connectionString="server=mysql-admin-personal-iic-2026-admin-personal-iic-2026.k.aivencloud.com;database=OFE;uid=avnadmin;pwd=AVNS_D9NXIT8nECYcHW1YV31;Port=16341;SslMode=Required;" providerName="MySql.Data.MySqlClient" />
