{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigin": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "cluster-auth",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "puestos": {
        "ClusterId": "cluster-puestos",
        "Match": {
          "Path": "/api/puestos/{**catch-all}"
        }
      },
      "oferentes-lista": {
        "ClusterId": "cluster-oferentes",
        "Match": {
          "Path": "/api/oferentes"
        }
      },
      "oferentes-detalle": {
        "ClusterId": "cluster-detalle",
        "Match": {
          "Path": "/api/oferentes/{identificacion}"
        }
      },
      "empleados": {
        "ClusterId": "cluster-empleados",
        "Match": {
          "Path": "/api/empleados/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "cluster-auth": {
        "Destinations": {
          "d1": {
            "Address": "https://sitiosweb-iic-apiauth.onrender.com"
          }
        }
      },
      "cluster-puestos": {
        "Destinations": {
          "d1": {
            "Address": "https://sitiosweb-iic-2.onrender.com"
          }
        }
      },
      "cluster-oferentes": {
        "Destinations": {
          "d1": {
            "Address": "https://sitiosweb-iic-oferentes.onrender.com"
          }
        }
      },
      "cluster-detalle": {
        "Destinations": {
          "d1": {
            "Address": "https://sitiosweb-iic.onrender.com"
          }
        }
      },
      "cluster-empleados": {
        "Destinations": {
          "d1": {
            "Address": "https://sitiosweb-iic-1.onrender.com"
          }
        }
      }
    }
  }
}
