                "health"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Registrar empleado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificacion\": \"1122334455\",\n  \"tipoIdentificacion\": \"F\",\n  \"nombreCompleto\": \"Juan Perez\",\n  \"fechaNacimiento\": \"1990-05-10T00:00:00\",\n  \"puestoId\": 1,\n  \"correos\": [\"juan.perez@correo.com\"],\n  \"telefonos\": [\"8888-8888\"],\n  \"usuario\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/empleados",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "empleados"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "El campo 'usuario' se ignora (se toma del token)."
          },
          "response": []
