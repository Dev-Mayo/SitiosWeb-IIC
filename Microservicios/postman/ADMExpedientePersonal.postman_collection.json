{
  "info": {
    "_postman_id": "b0f4b2a6-5c8d-4e3a-9f7d-1c2e3a4b5c6d",
    "name": "ADMExpedientePersonal (Microservicios)",
    "description": "Colección para probar los microservicios vía Gateway YARP (http://localhost:5080).\n1) Ejecuta Login para obtener el token (se guarda automáticamente en {{token}}).\n2) El resto de endpoints lo usan con Authorization: Bearer {{token}}.\n\nCredenciales reales: las que usaba la app web anterior (BD SEG).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "identificacion",
      "value": "1234567890",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (obtener token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"TU_USUARIO\",\n  \"password\": \"TU_PASSWORD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Autentica contra la BD SEG. En el script se guarda el token en la variable {{token}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 200 && jsonData && jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token guardado correctamente.');",
                  "} else {",
                  "    console.log('Login fallido:', jsonData);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (usuario del token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Puestos",
      "item": [
        {
          "name": "Listar puestos disponibles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/puestos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "puestos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Oferentes",
      "item": [
        {
          "name": "Oferentes por puesto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/oferentes?codigoPuesto=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "oferentes"
              ],
              "query": [
                {
                  "key": "codigoPuesto",
                  "value": "1"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Detalle de oferente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/oferentes/{{identificacion}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "oferentes",
                "{{identificacion}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Reemplaza la variable {{identificacion}} por una cédula real que exista en la BD OFE."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Empleados",
      "item": [
        {
          "name": "Health (conexión BD EMP)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/empleados/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
