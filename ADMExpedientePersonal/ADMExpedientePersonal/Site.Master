<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="ADMExpedientePersonal.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <title>Administración</title>
   <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="menuDinamico" runat="server">

        <div class="container-fluid">
            <div class="row min-vh-100">

                <!-- SIDEBAR -->
                <aside class="col-12 col-md-3 col-lg-2 text-white p-3" style="background-color: #1aad94;">

                    <!-- BRAND -->
                    <div class="text-center mb-4">
                        <h4 class="mb-0">Shirofy</h4>
                        <div class="mt-2">
                            <!-- WITH THIS -->
                        <asp:Image ID="imgLogo" runat="server" 
                                   ImageUrl="~/Assets/img/miniLogo.png"
                                   CssClass="img-fluid rounded" 
                                   style="max-width:80px;" />
                        </div>
                    </div>

                    <hr class="text-white" />

                    <!-- MENU -->
                    <div class="nav flex-column">

                        <asp:HyperLink CssClass="nav-link text-white" ID="lnkInicio" runat="server" NavigateUrl="~/SEG/Bienvenida.aspx" Text="Inicio" />

                        <asp:HyperLink CssClass="nav-link text-white" ID="lnkRoles" runat="server" NavigateUrl="~/SEG/AdminRoles.aspx" Text="Roles" />
                        <asp:HyperLink CssClass="nav-link text-white" ID="lnkPantallas" runat="server" NavigateUrl="~/SEG/AdminPantallas.aspx" Text="Pantallas" />
                        <asp:HyperLink CssClass="nav-link text-white" ID="lnkUsuarios" runat="server" NavigateUrl="~/SEG/AdminUsuarios.aspx" Text="Usuarios" />

                        <asp:HyperLink CssClass="nav-link text-white" ID="lnkOferentes" runat="server" NavigateUrl="~/OFE/MainOferentes.aspx" Text="Oferentes" />
                        <asp:HyperLink CssClass="nav-link text-white" ID="lnkConcursos" runat="server" NavigateUrl="~/OFE/RegistroConcursos.aspx" Text="Concursos" />
                        <asp:HyperLink CssClass="nav-link text-white" ID="lnkEntrevista" runat="server" NavigateUrl="~/OFE/AgendarEntrevista.aspx" Text="Agendar Entrevista" />

                        <asp:HyperLink CssClass="nav-link text-white" ID="lnkOfeEmpleado" runat="server" NavigateUrl="~/EMP/Oferente-a-Empleado.aspx" Text="Contratar empleado" />
                        <asp:HyperLink CssClass="nav-link text-white" ID="lnkPuestos" runat="server" NavigateUrl="~/EMP/AdminPuestos.aspx" Text="Puestos" />
                        <asp:HyperLink CssClass="nav-link text-white" ID="lnkAreas" runat="server" NavigateUrl="~/EMP/AdminAreas.aspx" Text="Áreas" />
                        <asp:HyperLink CssClass="nav-link text-white" ID="lnkAccPersonal" runat="server" NavigateUrl="~/EMP/AdminAccionesPersonal.aspx" Text="Acciones de Personal" />

                        <asp:HyperLink CssClass="nav-link text-white" ID="lnkBitacora" runat="server" NavigateUrl="~/GEN/VerBitacoras.aspx" Text="Bitácora" />
                        <asp:HyperLink CssClass="nav-link text-white" ID="lnkParametros" runat="server" NavigateUrl="~/GEN/AdminParametros.aspx" Text="Parámetros" />
                        <asp:HyperLink CssClass="nav-link text-white" ID="lnkCompanias" runat="server" NavigateUrl="~/GEN/AdminCompanias.aspx" Text="Compañías" />
                        <asp:HyperLink CssClass="nav-link text-white" ID="lnkCargarUbi" runat="server" NavigateUrl="~/GEN/AdminUbicaciones.aspx" Text="Cargar datos de ubicación" />
                        <asp:HyperLink CssClass="nav-link text-white" ID="lnkInsEdu" runat="server" NavigateUrl="~/GEN/AdminInsEducativas.aspx" Text="Instituciones educativas" />

                        <hr class="text-white" />

                        <asp:LinkButton CssClass="btn btn-danger btn-sm w-100" ID="lnkLogout" runat="server" OnClick="lnkLogout_Click">
                            Cerrar sesión
                        </asp:LinkButton>

                    </div>
                </aside>

                <!-- MAIN -->
                <main class="col-12 col-md-9 col-lg-10 p-0">

                    <!-- TOPBAR -->
                    <div class="d-flex justify-content-between align-items-center bg-light p-3 border-bottom">

                        <h5 class="mb-0">Sistema de Administración</h5>

                        <div class="d-flex align-items-center gap-2">
                            <asp:Label ID="lblUsuario" runat="server" CssClass="fw-bold"></asp:Label>
                            <img src="../Assets/img/admin.png" class="rounded-circle" width="40" height="40" />
                        </div>

                    </div>

                    <!-- CONTENT -->
                    <div class="p-4">
                        <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
                    </div>

                </main>

            </div>
        </div>

        <!-- WARNING SESSION -->
        <div id="inactivityBar"
             class="alert alert-warning position-fixed bottom-0 end-0 m-3 shadow"
             style="display:none; z-index:9999;">
            ⚠️ Su sesión está por expirar por inactividad.
        </div>

    </form>


    <script>
        (function () {
            const TIMEOUT_MS = 5 * 60 * 1000;
            const WARNING_MS = 4 * 60 * 1000;
            let timerWarning, timerLogout;

            function resetTimers() {
                clearTimeout(timerWarning);
                clearTimeout(timerLogout);
                timerWarning = setTimeout(showWarning, WARNING_MS);
                timerLogout  = setTimeout(forceLogout, TIMEOUT_MS);
            }

            function showWarning() {
                document.getElementById('inactivityBar').style.display = 'block';
            }

            function forceLogout() {
                window.location.href = '/SEG/Login.aspx?msg=expirado';
            }

            ['mousemove', 'keypress', 'click', 'scroll', 'touchstart']
                .forEach(ev => document.addEventListener(ev, resetTimers));

            resetTimers();
        })();
    </script>
</body>
</html>